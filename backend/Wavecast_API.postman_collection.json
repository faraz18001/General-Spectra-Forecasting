{
  "info": {
    "_postman_id": "wavecast-forecasting-api-v1",
    "name": "Wavecast Forecasting Service API",
    "description": "Complete Postman API Collection for Wavecast Volume Forecasting & Simulation Engine.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8079",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login User / Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"adminpassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "localhost"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Branches & Categories",
      "item": [
        {
          "name": "Get All Branches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "localhost"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/branches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "branches"
              ]
            }
          }
        },
        {
          "name": "Get Branch Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "localhost"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories?branch_name=Brampton",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ],
              "query": [
                {
                  "key": "branch_name",
                  "value": "Brampton"
                }
              ]
            }
          }
        }
      ]
    },
